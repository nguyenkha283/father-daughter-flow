# KHONG commit file .env. Tren GitHub Actions dung Secrets, khong dung file nay.

# --- YouTube (OAuth Desktop client) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Giu 'private' cho den khi project qua compliance audit, roi doi thanh 'public'
YT_PRIVACY=private

# --- Facebook Page ---
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- X (OAuth 1.0a) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Bat/tat tung nen tang ---
PUBLISH_YOUTUBE=1
PUBLISH_FACEBOOK=1
PUBLISH_X=1
